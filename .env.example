# ============================================================================
# BACKEND - Marketplace Link (Spring Boot)
# Copia este archivo a .env y ajusta los valores. NO subas el .env real.
# ============================================================================

# ----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL + PostGIS)
# ----------------------------------------------------------------------------
# Si el backend corre en Docker, usa el nombre del servicio (mplink_postgres).
# Si corre con ./mvnw en el host, usa localhost y el puerto publicado.
DB_HOST=mplink_postgres
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=cambia-esta-password

# ----------------------------------------------------------------------------
# BASE DE DATOS - Testing (opcional, solo para tests de integración)
# ----------------------------------------------------------------------------
DB_HOST_TEST=mplink_postgres_test
DB_PORT_TEST=5432
DB_NAME_TEST=marketplace_test_db
DB_USER_TEST=postgres
DB_PASSWORD_TEST=cambia-esta-password

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
SERVER_PORT=8080

# ----------------------------------------------------------------------------
# SEGURIDAD (JWT)
# ----------------------------------------------------------------------------
# Clave para firmar los tokens JWT. DEBE tener al menos 256 bits (>=32 chars).
# Genera una nueva con:  openssl rand -base64 48
JWT_SECRET=genera-una-clave-segura-de-al-menos-32-caracteres

# ----------------------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP)
# ----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password

# ----------------------------------------------------------------------------
# FRONTEND / CORS
# ----------------------------------------------------------------------------
# Orígenes permitidos por CORS y URL usada en enlaces de emails.
# Varios orígenes separados por coma. En producción usa el dominio real.
# Ej.: https://midominio.com
FRONTEND_URL=http://localhost:5174,http://localhost

# ----------------------------------------------------------------------------
# CONFIGURACIÓN DE NEGOCIO
# ----------------------------------------------------------------------------
SUSPENDED_TIME_DAYS=30
MODERATOR_DEFAULT_PASSWORD=cambia-esta-password
